# Copia este archivo como apps/api/.env y rellénalo. Nunca subas el .env al repositorio.
NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# Neon: cadena "pooled" de la rama dev (en local) o main (en Render)
DATABASE_URL=

# Firma de la cookie de sesión (en Render: valor largo y aleatorio)
JWT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Dirección pública de las fotos (Worker en workers.dev)
PUBLIC_ASSETS_URL=

# OpenRouteService (fase 4)
ORS_API_KEY=

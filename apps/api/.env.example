# Copia este archivo como apps/api/.env y rellénalo. Nunca subas el .env al repositorio.
# Las variables vacías usan su valor por defecto.
NODE_ENV=development
PORT=3000

# Orígenes desde los que se aceptan escrituras, separados por comas
# (por defecto: http://localhost:5173,https://santiagos.netlify.app)
ALLOWED_ORIGIN=

# Neon: cadena "pooled" de la rama dev (en local) o main (en Render).
# Usa sslmode=verify-full para evitar el aviso de seguridad de pg.
DATABASE_URL=

# Base para los tests de integración (¡se borra entera!). Nunca la de producción.
TEST_DATABASE_URL=

# Firma de la cookie de sesión. Obligatorio en producción (32 caracteres o más).
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Dirección pública de las fotos (por defecto: https://caminos-fotos.j4alonso.workers.dev)
PUBLIC_ASSETS_URL=

# OpenRouteService (fase 4)
ORS_API_KEY=
